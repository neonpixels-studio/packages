{
  "name": "@neon-pixels/eslint-config",
  "version": "0.5.0",
  "description": "Shared ESLint flat configuration for Neon Pixels projects (Nuxt, VitePress, Node).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neonpixels-studio/packages.git",
    "directory": "packages/eslint-config"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./nuxt": {
      "types": "./nuxt.d.ts",
      "default": "./nuxt.js"
    },
    "./vitepress": {
      "types": "./vitepress.d.ts",
      "default": "./vitepress.js"
    },
    "./node": {
      "types": "./node.d.ts",
      "default": "./node.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "nuxt.js",
    "nuxt.d.ts",
    "vitepress.js",
    "vitepress.d.ts",
    "node.js",
    "node.d.ts",
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.17.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@eslint/js": "^10.0.0",
    "@nuxt/eslint": ">=1.0.0 <2",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^10.12.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "globals": ">=16.0.0",
    "typescript-eslint": "^8.73.0",
    "vue-eslint-parser": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/eslint": {
      "optional": true
    },
    "eslint-plugin-vue": {
      "optional": true
    },
    "eslint-plugin-vuejs-accessibility": {
      "optional": true
    },
    "vue-eslint-parser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.73.0",
    "vue-eslint-parser": "^10.4.2"
  }
}
