{
  "name": "@neon-pixels/tsconfig",
  "version": "0.2.0",
  "description": "Shared TypeScript configuration bases for Neon Pixels projects.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neonpixels-studio/packages.git",
    "directory": "packages/tsconfig"
  },
  "exports": {
    ".": "./base.json",
    "./nuxt": "./nuxt.json",
    "./vitepress": "./vitepress.json",
    "./node": "./node.json",
    "./package.json": "./package.json"
  },
  "files": [
    "base.json",
    "nuxt.json",
    "vitepress.json",
    "node.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.17.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0",
    "@types/node": ">=22"
  },
  "devDependencies": {
    "@neon-pixels/tsconfig": "workspace:*",
    "@types/node": "^26.6.6",
    "typescript": "~6.0.3"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    }
  }
}
