  },
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./nuxt.config": "./nuxt.config.ts",
    "./build": "./shared/lib/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "nuxt.config.ts",
    "server",
    "shared"
  ],
  "publishConfig": {
