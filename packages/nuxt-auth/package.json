  "description": "Nuxt layer with Clerk server authentication for Neon Pixels apps: bearer token middleware, session verification, user resolution, and reverification. Shipped as source.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neonpixels-studio/packages.git",
