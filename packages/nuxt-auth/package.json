  },
  "dependencies": {
    "@neon-pixels/nuxt-base": "workspace:*"
  },
  "peerDependencies": {
    "@clerk/backend": "^3.0.0",
    "@clerk/nuxt": "^3.0.0",
    "nuxt": "^4.0.0"
  },
  "devDependencies": {
    "@clerk/backend": "3.31.4",
    "@clerk/nuxt": "3.1.30",
    "@nuxt/kit": "^4.7.0",
    "h3": "^1.15.4",
    "nuxt": "^4.7.0"
  }
