{
  "name": "@neon-pixels/scripts",
  "version": "0.6.0",
  "description": "CI and deploy scripts for Neon Pixels projects: dependency audit gate, a build-output check that a dependency is absent, GitHub Actions pinning check, migration bookkeeping checks, Lighthouse failure reporting, Netlify production deploy checks, and a sync of hooks, Dependabot, gitleaks, and Node version templates.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neonpixels-studio/packages.git",
    "directory": "packages/scripts"
  },
  "bin": {
    "np-audit-gate": "./dist/audit-gate.js",
    "np-check-absent-dependency": "./dist/check-absent-dependency.js",
    "np-check-action-pinning": "./dist/check-action-pinning.js",
    "np-check-migration-drift": "./dist/check-migration-drift.js",
    "np-check-migration-snapshots": "./dist/check-migration-snapshots.js",
    "np-report-lighthouse-failure": "./dist/report-lighthouse-failure.js",
    "np-should-deploy": "./dist/should-deploy.js",
    "np-sync-templates": "./dist/sync-templates.js",
    "np-verify-netlify-deploy": "./dist/verify-netlify-deploy.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.17.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
