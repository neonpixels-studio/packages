{
  "name": "@neon-pixels/scripts",
  "version": "0.1.0",
  "description": "CI and deploy scripts for Neon Pixels projects: dependency audit gate, GitHub Actions pinning check, and Netlify production deploy checks.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neonpixels-studio/packages.git",
    "directory": "packages/scripts"
  },
  "bin": {
    "np-audit-gate": "./dist/audit-gate.js",
    "np-check-action-pinning": "./dist/check-action-pinning.js",
    "np-should-deploy": "./dist/should-deploy.js",
    "np-verify-netlify-deploy": "./dist/verify-netlify-deploy.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.17.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
