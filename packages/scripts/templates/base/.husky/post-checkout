# post-merge misses branch switches, so a checkout onto a branch with new
# dependencies would otherwise leave node_modules stale. $3 is 1 for a branch
# checkout and 0 for a file checkout.
if [ "$3" != "1" ]; then
  exit 0
fi

if git diff --name-only "$1" "$2" 2>/dev/null | grep -qE '^(package\.json|package-lock\.json)$'; then
  echo "package.json or lockfile changed - running npm install..."
  npm install
fi
