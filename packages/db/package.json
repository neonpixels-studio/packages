{
  "name": "@neon-pixels/db",
  "version": "0.6.0",
  "description": "Neon HTTP drizzle client, URL resolvers, batch helper, audit timestamps, offset pagination, and a PGlite test database.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neonpixels-studio/packages.git",
    "directory": "packages/db"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.17.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.0"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4"
  }
}
