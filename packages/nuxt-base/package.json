{
  "name": "@neon-pixels/nuxt-base",
  "version": "0.7.0",
  "description": "Nuxt layer with the shared Nuxt config, validated site URL, and Sentry start-up for Neon Pixels apps. Shipped as source.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neonpixels-studio/packages.git",
    "directory": "packages/nuxt-base"
  },
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./nuxt.config": "./nuxt.config.ts",
    "./build": "./shared/lib/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "nuxt.config.ts",
    "sentry.client.config.ts",
    "sentry.server.config.ts",
    "app",
    "server",
    "shared"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.17.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@neon-pixels/security": "workspace:*",
    "@neon-pixels/sentry": "workspace:*"
  },
  "peerDependencies": {
    "h3": "^1.15.4",
    "@sentry/nuxt": "^11.0.0",
    "nuxt": "^4.0.0"
  },
  "devDependencies": {
    "@nuxt/kit": "^4.7.0",
    "@sentry/nuxt": "11.16.0",
    "h3": "^1.15.4",
    "nuxt": "^4.7.0"
  }
}
