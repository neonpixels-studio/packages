{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2024", "DOM"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@neon-pixels/consent": ["../consent/src/index.ts"],
      "@neon-pixels/consent/testing": ["../consent/src/testing.ts"]
    }
  },
  "include": ["*.ts", "app", "shared", "testing", "tests/*.ts"],
  "exclude": ["tests/fixtures"]
}
