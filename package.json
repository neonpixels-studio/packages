{
  "name": "neon-pixels-packages",
  "private": true,
  "description": "Public @neon-pixels packages, versioned together.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^22.17.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" --if-present run build",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint --fix .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter \"./packages/*\" --if-present run typecheck",
    "test": "vitest",
    "test:ci": "vitest run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@neon-pixels/eslint-config": "workspace:*",
    "@neon-pixels/prettier-config": "workspace:*",
    "@neon-pixels/scripts": "workspace:*",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "pkg-pr-new": "^0.0.94",
    "prettier": "^3.10.1",
    "tsdown": "^0.23.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
